@theme "catppuccin-default"

@import "catppuccin-mocha"

configuration{
    mode: ["drun", "window", "run"];
    icon-theme: "Papirus-Dark";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    sidebar-mode: false;
    display-drun: " ";
    display-run: " ";
    display-window: " ";

    //kb-accept-entry: "Return,KP_Enter";

    //fixing up
    //kb-remove-to-eol: "";
    //kb-remove-char-back: "BackSpace";
    //kb-mode-complete: "Control+o";
}

window {
    location: center;
    anchor: center;
    width: 600px;
    y-offset: 12px;

    border: 2px;
    border-radius: 4px;
}

mainbox {
    spacing: 8px;
    padding: 12px;
}

inputbar {
    spacing: 8px;
    padding: 8px;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    fixed-height: false;
}

element {
    padding: 8px;
    spacing: 8px;

    children: [ element-icon, element-text ];
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
